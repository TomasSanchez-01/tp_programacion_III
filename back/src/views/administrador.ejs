<%- include("partials/head.ejs") %> 
    
<header>
    <div id="marca">
        <a href="/dashboard/principal">
            <img id="logo" src="../img/imagen_simple.png" alt="logo" width="80px">
            <h1>Manto sagrado</h1>
        </a>
    </div>
    <div>
        <button id="btn-tema" class="btn btn-lleno">Modo oscuro</button>
        <form action="/logout" method="POST" class="form-logout">
            <button type="submit" id="btn-logout" class="btn btn-lleno">Logout</button>
        </form>
        <a href="crear" id="btn-crear" class="btn btn-lleno">Crear Usuarios</a>
    </div>
</header> 

<main>
    </div>
    <form id="getProductForm">
        <input class="inputsForm" type="number" name="id" id="idProd" min="1" placeholder="Buscar por id">
        <input class = "btn" type="submit" value="Buscar">
    </form>
    <section id="tabla-admin"></section>
    <button class="btn btn-lleno btn-agregar" onclick="formNuevoProducto()" >Agregar</button>
    
    <div class="cargarProducto" id="cargarProducto"></div>
    <div id="mensaje">
</main>

<dialog id="modal-confirmar">
    <h4>¿Quieres eliminar este producto?</h4>
    <div class="modal-acciones">
        <button type="button" class= "btn btn-celeste" id="btn-cancelar">Cancelar</button>
        <button type="button" class= "btn" id="btn-confirmar">Eliminar</button>
    </div>
</dialog>

<script src="/js/administrador.js"></script>


<%- include("partials/footer.ejs") %>